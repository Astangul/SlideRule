DEBUT_ADVANTG

method cadis

mcnp_input   i.mcnp     # MCNP input filename
mcnp_tallies 1014 14 24 34   # Tally id

mcnp_material_names 1 air # For visualization output
                    2 ground
                    3 Umetal
                    4 lead_wall

anisn_library 27n19g # Multigroup library for Denovo
# SN calculation

denovo_pn_order 3
denovo_quad_num_polar 4
denovo_quad_num_azi 4

mesh_x      -153000 -30  30  @{$rfis_cm+D_m/2*100-1|0}   @{$rfis_cm+D_m/2*100+$wall_thk_cm+1|0}   @{if($D_m > 100){($D_m*100+$rfis_cm)-40} else {($D_m*100+$rfis_cm)-20} | 0}   @{if($D_m > 100){($D_m*100+$rfis_cm)+40} else {($D_m*100+$rfis_cm)+20} | 0}  153000  # Coarse mesh boundaries
mesh_x_ints          10  1  20  @{$wall_thk_cm*2|0}  10  1  30 # Number of fine meshes per coarse mesh

mesh_y      -153000 -30 30 153000
mesh_y_ints          40 1  40

mesh_z      -50.5 0  70 130 153000
mesh_z_ints       2  3  1   20

FIN_ADVANTG

SlideRule
9999   0     +10001 : +10002 : -10003        imp:n,p=0
c External air volume
11   1   5.007e-5 -10001  -10002 +10004  +10000 #206 
         #306 imp:n,p=1
c concrete ground
2   2   8.17926e-02 -10001  -10004 +10003       imp:n,p=1
c Sphere of Umetal
1   3   4.8264E-02 -10000  imp:n,p=1
c detector
306  1  5.007e-5  -30600 imp:n,p=1
c lead_wall
206 4  3.2988E-02 -10001 +10004 +20001 -20002 -10002 imp:n,p=1

c fissile sphere
10000 s 0 0 100 @{$rfis_cm|0.00000}
c External cylinder of 1.5 km
10001 cz 153000
c Sky plan
10002 pz 153000
10003 pz -50.0
10004 pz 0
c detector (center) 306 at @{D_m|0.00000} m (from the source edge) with a radius of @{if($D_m > 100){40} else{20} | 0} cm
30600 s @{$rfis_cm+D_m*100|0.00000} 0 100 @{if($D_m > 100){40} else{20} | 0}
c wall at @{$rfis_cm+D_m/2*100|0.00000} cm (from the source edge) with a thickness of @{$wall_thk_cm|0} cm 
20001 px @{$rfis_cm+D_m/2*100|0.00000}
20002 px @{$rfis_cm+D_m/2*100+$wall_thk_cm|0.00000}

m1 nlib=80c plib=04p $ air
      7014 4.0000e-05  8016 1.11000e-05
m2 nlib=80c plib=04p $ concrete
     8016  4.60690E-02 14028 1.53273E-02 14029 7.78639E-04
     14030 5.13885E-04 20040 1.47412E-03 20042 9.83851E-06
     20043 2.05286E-06 20044 3.17205E-05 20046 6.08254E-08
     20048 2.84359E-06 13027 1.74538E-03 11023 1.74720E-03
     26054 2.02958E-05 26056 3.18600E-04 26057 7.35787E-06
     26058 9.79198E-07 1001 1.37433E-02
mt2  lwtr.20t
m3 nlib=80c plib=04p $ Umetal
      92235 4.5012E-2  92238 2.6704E-3 92236 9.6182E-5
      92234 4.8503E-4
m4 nlib=80c plib=04p $ lead
     82204  4.6183E-04
     82206  7.9501E-03
     82207  7.2903E-03
     82208  1.7286E-02
MODE N
SDEF PAR=N POS=0 0 100 ERG=D1 RAD=D2
SI1   S 11 12
SP1   0.98197  0.00935
SI11  1E-9 150ILOG 20
SP11  -3 0.988 2.249 $ U5 watt spectra thermal
SI12  1E-11 
