     26058 9.79198E-07 1001 1.37433E-02
mt2  lwtr.20
m3 nlib=80c plib=04p $ {Nom_Source}
     {Compo_Source}
m4 nlib=80c plib=04p $ reg_concrete
     {Compo_Wall}
