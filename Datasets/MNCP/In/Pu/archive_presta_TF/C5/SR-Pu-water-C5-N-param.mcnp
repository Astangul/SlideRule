     26054 2.02958E-05 26056 3.18600E-04 26057 7.35787E-06
     26058 9.79198E-07 1001 1.37433E-02
mt2  lwtr.20
m3 nlib=80c plib=04p $ {Nom_Source}
     {Compo_Source}
m4 nlib=80c plib=04p $ {Nom_Wall}
     {Compo_Wall}
MODE {Mode}
