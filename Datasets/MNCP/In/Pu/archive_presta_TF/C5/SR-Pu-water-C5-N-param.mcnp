<donnees>
    <nom>SR_Pu_UN_G1_C1_{Mode}_D{Nom_Position_Detecteur}m_Lw_{Nom_Distance_Wall}cm_Epw{Epaisseur_Wall}cm_w_concrete.i</nom>

    <!-- Script de lancement (éventuellement) -->
    <script>lancer_simulation.sh</script>
	
	<variable nom="Mode">N</variable>

    <!-- Déclaration d'un groupement -->
    <groupement nom="Source">
        <variable nom="Nom_Source">Pu_O2_h2000</variable>
        <variable nom="Densite_Source">1.000491386E-01</variable>
		<variable nom="Rayon_Source">29.17</variable>
		<blocTexte nom="Compo_Source">      94239 3.33386E-05 8016  3.33386E-02 1001  6.66772E-02
mt3   lwtr.20t </blocTexte>
    </groupement>

    <!-- Déclaration d'un groupement -->
    <groupement nom="Wall">
        <variable nom="Nom_Wall">water</variable>
        <variable nom="Densite_Wall">1.00101E-01</variable>
		<blocTexte nom="Compo_Wall">     8016  6.6733E-02
     1001  3.3368E-02
mt4 lwtr.20t </blocTexte>
    </groupement>

    <!-- Déclaration de variables -->
	<variable nom="Epaisseur_Wall">1 5 10 20 40</variable>

    <!-- Déclaration d'un groupement -->
    <groupement nom="Detecteur">
        <variable nom="Position_Detecteur">100 200 500 1000 2000 5000 10000 20000 30000 50000 70000 100000 120000</variable>
		<variable nom="Nb_Particules">3e8 3e8 3e8 3e8 3e8 3e8 3e8 3e8 3e8 3e8 5e8 5e8 5e8</variable>
		<variable nom="Nom_Distance_Wall">50 100 250 500 1000 2500 5000 10000 15000 25000 35000 50000 60000</variable>
		<blocTexte nom="mesh_x1">-30 </blocTexte>
		<variable nom="mesh_x2">30 30 30 30 30 30 30 30 30 30 30 30 30</variable>
		<variable nom="mesh_x3">50 100 250 500 1000 2500 5000 10000 15000 25000 35000 50000 60000</variable>
		<variable nom="mesh_x4">51 101 251 501 1001 2501 5001 10001 15001 25001 35001 50001 60001</variable>
		<variable nom="mesh_x5">95 195 495 995 1995 4995 9995 19995 29995 49995 69995 99995 119995</variable>
		<variable nom="mesh_x6">155 255 555 1055 2055 5055 10055 20055 30055 50055 70055 100055 120055</variable>
		<variable nom="mesh_x1_int1">10</variable>
		<variable nom="mesh_x2int2">1</variable>
		<variable nom="mesh_x3int3">20</variable>
		<variable nom="mesh_x4int4">40</variable>
		<variable nom="mesh_x5int5">10</variable>
		<variable nom="mesh_x6int6">1</variable>
		<variable nom="mesh_x7int7">30</variable>
    </groupement>
	
    <!-- Déclaration de formules -->
    <formules>
        <variable nom="Nom_Position_Detecteur">Position_Detecteur / 100</variable>
        <variable nom="Distance_Detecteur">Position_Detecteur + Rayon_Source</variable>
		<variable nom="Distance_Wall">(Position_Detecteur / 2) + Rayon_Source</variable>
		<variable nom="Distance_Fin_Wall">Distance_Wall + Epaisseur_Wall</variable>
		<variable nom="Maillage_x_ep">mesh_x4 + Epaisseur_Wall</variable>
    </formules>
 </donnees>
DEBUT_ADVANTG

method cadis

mcnp_input   i.mcnp     # MCNP input filename 
mcnp_tallies 14         # Tally id

mcnp_material_names 1 air # For visualization output
                    2 ground
					3 {Nom_Source}
                    4 wall

anisn_library 27n19g # Multigroup library for Denovo
# SN calculation

denovo_pn_order 3
denovo_quad_num_polar 4
denovo_quad_num_azi 4

mesh_x      -153000 {mesh_x1} {mesh_x2} {mesh_x3} {Maillage_x_ep} {mesh_x5} {mesh_x6}  153000  # Coarse mesh boundaries
mesh_x_ints          {mesh_x1_int1}  {mesh_x2int2}  {mesh_x3int3}  {mesh_x4int4}  {mesh_x5int5}  {mesh_x6int6}  {mesh_x7int7} # Number of fine meshes per coarse mesh

mesh_y      -153000 -30 30 153000
mesh_y_ints          40 1  40

mesh_z      -50.5 0  70 130 153000
mesh_z_ints       2  3  1   20

FIN_ADVANTG

Sliderules
9999   0     +10001 : +10002 : -10003        imp:n,p=0
c External air volume
11   1   5.007e-5 -10001  -10002 +10004  +10000 #206 
         #306 imp:n,p=1
c concrete ground
2   2   8.17926e-02 -10001  -10004 +10003       imp:n,p=1
c Sphere of {Nom_Source}
1   3   {Densite_Source} -10000  imp:n,p=1
c detector
306  1  5.007e-5  -30600 imp:n,p=1
c reg_concrete wall
206 4  {Densite_Wall} -10001 +10004 +20001 -20002 -10002 imp:n,p=1

c fissile sphere
10000 s 0 0 100 {Rayon_Source}
c External cylinder of 1.5 km
10001 cz 153000
c Sky plan
10002 pz 153000
10003 pz -50.0
10004 pz 0
c detector 306 at {Nom_Position_Detecteur} m and a radius of 20 cm
30600 s {Distance_Detecteur} 0 100 20
c wall at {Distance_Wall} cm and thickness of {Epaisseur_Wall} cm 
20001 px {Distance_Wall}
20002 px {Distance_Fin_Wall}

m1 nlib=80c plib=04p $ air
      7014 4.0000e-05  8016 1.11000e-05
m2 nlib=80c plib=04p $ concrete
     8016 4.60690E-02 14028 1.53273E-02 14029 7.78639E-04
     14030 5.13885E-04 20040 1.47412E-03 20042 9.83851E-06
     20043 2.05286E-06 20044 3.17205E-05 20046 6.08254E-08
