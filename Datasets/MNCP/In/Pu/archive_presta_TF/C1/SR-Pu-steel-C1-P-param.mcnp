<donnees>
    <nom>SR_Pu_UN_G1_C1_{Mode}_D{Nom_Position_Detecteur}m_Lw_{Nom_Distance_Wall}cm_Epw{Epaisseur_Wall}cm_w_concrete.i</nom>

    <!-- Script de lancement (éventuellement) -->
    <script>lancer_simulation.sh</script>
	
	<variable nom="Mode">P</variable>

    <!-- Déclaration d'un groupement -->
    <groupement nom="Source">
        <variable nom="Nom_Source">Pu_O2_h0</variable>
        <variable nom="Densite_Source">5.00305E-2</variable>
		<variable nom="Rayon_Source">4.93</variable>
		<blocTexte nom="Compo_Source">94239 5.00305E-2 </blocTexte>
    </groupement>

    <!-- Déclaration d'un groupement -->
    <groupement nom="Wall">
        <variable nom="Nom_Wall">steel</variable>
        <variable nom="Densite_Wall">8.76910E-02</variable>
		<blocTexte nom="Compo_Wall">     6000   1.6000E-04
     15031  3.6000E-05
     25055  8.7700E-04
     14028  7.8821E-04
     14029  4.1476E-05
     14030  2.8314E-05
